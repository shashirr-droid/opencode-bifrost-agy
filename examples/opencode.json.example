{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "github:shashirr-droid/opencode-bifrost-agy",
      "options": {
        "bifrostUrl": "https://bifrost.example.internal",
        "gcpLocation": "global",
        "baicodeUserTier": "gcp-ge-plus-tier",
        "permissionMode": "accept-edits"
      }
    }
  ]
}
