# Sanitized Bifrost Gateway Environment Template (/etc/bifrost/bifrost.env)
# Never commit real secrets. Instead of editing placeholders by hand, see
# docs/INSTALLATION_AND_CONFIGURATION.md (Step 3 -> Path C) for a single
# copy-paste `openssl rand` command that auto-generates this entire file!

# --- Upstream Cloud Provider Settings ---
VERTEX_PROJECT_ID=<YOUR_VERTEX_GCP_PROJECT_ID>
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY_OPTIONAL>

# --- Section A: Gateway Admin Infrastructure Secrets (NEVER shared with developers) ---
# 1. Protects the Bifrost Web Dashboard UI and /api/* admin endpoints:
BIFROST_ADMIN_PASSWORD=<AUTO_GENERATED_VIA_OPENSSL_RAND>

# 2. Authenticates Bifrost -> agy-receipt-echo (or local 127.0.0.1:8091 in through-bifrost mode):
SHIM_SHARED_SECRET=<AUTO_GENERATED_VIA_OPENSSL_RAND>

# --- Section B: Developer Virtual Keys (Shared with developers for `opencode auth login bifrost-agy`) ---
# 3. Standard non-/agy coding key (vertex/*, anthropic/* — blocks /agy):
VK_OPENCODE_DEFAULT=sk-bf-std-<AUTO_GENERATED_HEX>

# 4. Antigravity (/agy) key (authorizes approved agy-cli/* models & Dashboard telemetry):
VK_OPENCODE_AGY=sk-bf-agy-<AUTO_GENERATED_HEX>
