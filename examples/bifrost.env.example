# Sanitized Bifrost Gateway Environment Template (/etc/bifrost/bifrost.env)
# Replace all <PLACEHOLDER> tokens with your organization's values. Never commit real secrets.

VERTEX_PROJECT_ID=<YOUR_VERTEX_GCP_PROJECT_ID>
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY_OPTIONAL>

# Shared loopback token used ONLY when Bifrost runs on the same workstation as OpenCode (through-bifrost mode)
SHIM_SHARED_SECRET=<GENERATE_RANDOM_HEX_SECRET>

# Scoped Bifrost Virtual Keys distributed to developers
VK_OPENCODE_DEFAULT=sk-bf-std-<GENERATE_RANDOM_HEX_1>
VK_OPENCODE_AGY=sk-bf-agy-<GENERATE_RANDOM_HEX_2>
